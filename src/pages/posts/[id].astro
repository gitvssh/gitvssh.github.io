---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleToc from '../../components/ArticleToc.astro';
import OfficialResourceCards from '../../components/OfficialResourceCards.astro';
import RelatedPostCard from '../../components/RelatedPostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPostDisplayTitle, getRelatedPosts, sortPosts, sortSeriesPosts, TECH_CATEGORIES, TRACKS } from '../../lib/content';
import { breadcrumbSchema, organizationSchema, personSchema, type BreadcrumbItem } from '../../lib/schema';
import { AUTHOR_NAME, SOCIAL_IMAGE_HEIGHT, SOCIAL_IMAGE_WIDTH, socialImagePathForPost } from '../../lib/site';
import { getPublishedTopics, getTopicsForPost, type PublishedTopic } from '../../lib/topics';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
  const publishedTopics = getPublishedTopics(posts);

  return posts.map((post) => {
    const seriesPosts = post.data.series
      ? sortSeriesPosts(
          posts.filter((candidate) => candidate.data.series?.slug === post.data.series?.slug),
        )
      : [];
    const seriesIndex = seriesPosts.findIndex((candidate) => candidate.id === post.id);

    return {
      params: { id: post.id },
      props: {
        post,
        relatedPosts: getRelatedPosts(post, posts),
        topics: getTopicsForPost(post, publishedTopics),
        previousSeriesPost: seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : undefined,
        nextSeriesPost:
          seriesIndex >= 0 && seriesIndex < seriesPosts.length - 1
            ? seriesPosts[seriesIndex + 1]
            : undefined,
      },
    };
  });
}

interface Props {
  post: CollectionEntry<'posts'>;
  relatedPosts: CollectionEntry<'posts'>[];
  topics: PublishedTopic[];
  previousSeriesPost?: CollectionEntry<'posts'>;
  nextSeriesPost?: CollectionEntry<'posts'>;
}

const { post, relatedPosts, topics, previousSeriesPost, nextSeriesPost } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const showToc = tocHeadings.filter(({ depth }) => depth === 2).length >= 5;
const track = TRACKS[post.data.track];
const category = post.data.category ? TECH_CATEGORIES[post.data.category] : undefined;
const displayTitle = getPostDisplayTitle(post.data);
const searchTitle = `${post.data.searchTitle ?? post.data.title} | ${AUTHOR_NAME}`;
const postPath = `/posts/${post.id}/`;
const canonical = new URL(postPath, Astro.site);
const socialImage = socialImagePathForPost(post.id);
const socialImageUrl = new URL(socialImage, Astro.site);
const coverUrl = new URL(post.data.cover.src, Astro.site);
const wordCount = post.body ? post.body.replace(/[#*_>`\[\]()!-]/g, ' ').split(/\s+/).filter(Boolean).length : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': post.data.track === 'news' ? 'NewsArticle' : 'BlogPosting',
  '@id': canonical.href,
  headline: displayTitle,
  name: displayTitle,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  inLanguage: 'ko-KR',
  url: canonical.href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
  // 16:9 social crop first, then the full portrait cover so Google has two aspect ratios.
  image: [socialImageUrl.href, coverUrl.href],
  thumbnailUrl: socialImageUrl.href,
  author: personSchema(Astro.site),
  publisher: organizationSchema(Astro.site),
  articleSection: category?.label ?? track.label,
  keywords: post.data.tags.join(', '),
  isAccessibleForFree: true,
  isPartOf: post.data.series
    ? {
        '@type': 'CreativeWorkSeries',
        name: post.data.series.title,
        url: new URL(`/series/${post.data.series.slug}/`, Astro.site).href,
        position: post.data.series.order,
      }
    : { '@id': `${new URL('/', Astro.site).href}#website` },
  ...(wordCount && { wordCount }),
  ...(post.data.sourceUrl?.startsWith('https://') && { citation: post.data.sourceUrl }),
};
const breadcrumbs: BreadcrumbItem[] = [
  { name: '홈', path: '/' },
  { name: track.label, path: `/tracks/${post.data.track}/` },
];
if (category) breadcrumbs.push({ name: category.label, path: `/categories/${post.data.category}/` });
if (post.data.series) breadcrumbs.push({ name: post.data.series.title, path: `/series/${post.data.series.slug}/` });
breadcrumbs.push({ name: displayTitle, path: postPath });
const archiveHref = category ? `/categories/${post.data.category}/` : `/tracks/${post.data.track}/`;
const archiveLabel = category ? `${category.label} 글 더 보기` : `${track.label} 글 더 보기`;
const hasUpdatedDate =
  post.data.updatedAt && post.data.updatedAt.valueOf() > post.data.publishedAt.valueOf();
---

<BaseLayout
  title={searchTitle}
  socialTitle={displayTitle}
  description={post.data.description}
  image={socialImage}
  imageAlt={post.data.coverAlt}
  imageWidth={SOCIAL_IMAGE_WIDTH}
  imageHeight={SOCIAL_IMAGE_HEIGHT}
  type="article"
  completeTitle
  jsonLd={[articleSchema, breadcrumbSchema(breadcrumbs, Astro.site)]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishedAt.toISOString()} />
    <meta property="article:modified_time" content={(post.data.updatedAt ?? post.data.publishedAt).toISOString()} />
    <meta property="article:author" content={new URL('/about/', Astro.site)} />
    <meta property="article:section" content={category?.label ?? track.label} />
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  <article
    class="article"
    data-analytics-article
    data-content-id={post.id}
    data-content-track={post.data.track}
    data-content-category={post.data.category}
  >
    <header class="article-header shell shell--article">
      <nav class="breadcrumb" aria-label="현재 위치">
        <a href="/">홈</a><span aria-hidden="true">/</span><a href={`/tracks/${post.data.track}/`}>{track.label}</a>
        {category && <><span aria-hidden="true">/</span><a href={`/categories/${post.data.category}/`}>{category.label}</a></>}
        {post.data.series && <><span aria-hidden="true">/</span><a href={`/series/${post.data.series.slug}/`}>{post.data.series.title}</a></>}
      </nav>
      <div class="post-meta">
        <span class={`track-label track-label--${post.data.track}`}>{track.label}</span>
        {category && <a class="category-label" href={`/categories/${post.data.category}/`}>{category.label}</a>}
        {post.data.series && <a class="series-label" href={`/series/${post.data.series.slug}/`}>{post.data.series.title} {post.data.series.order}편</a>}
        <a class="author-link" href="/about/" rel="author">글·해설: {AUTHOR_NAME}</a>
        <span>발행 <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time></span>
        {hasUpdatedDate && <span>수정 <time datetime={post.data.updatedAt?.toISOString()}>{formatDate(post.data.updatedAt!)}</time></span>}
      </div>
      {
        topics.length > 0 && (
          <nav class="article-topics" aria-label="관련 주제">
            <span>관련 주제</span>
            {topics.map((topic) => (
              <a href={`/topics/${topic.slug}/`}>#{topic.label}</a>
            ))}
          </nav>
        )
      }
      <h1>{displayTitle}</h1>
      <div class="article-deck">
        <span>이 글에서 얻는 것</span>
        <p>{post.data.description}</p>
      </div>
    </header>

    <figure class="article-cover shell shell--wide">
      <Image
        src={post.data.cover}
        alt={post.data.coverAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 920px) 760px, 92vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    {post.data.officialResources?.length && <OfficialResourceCards resources={post.data.officialResources} />}

    <div class:list={['article-body', { 'article-body--with-toc': showToc }]}>
      {showToc && <ArticleToc headings={tocHeadings} />}
      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="article-footer shell" data-analytics-complete>
      {
        post.data.series && (
          <nav class="series-navigation" aria-label="연재 글 이동">
            <div>
              {previousSeriesPost ? (
                <a href={`/posts/${previousSeriesPost.id}/`}>
                  <span>이전 편</span>
                  {previousSeriesPost.data.title}
                </a>
              ) : (
                <span class="series-navigation__empty">첫 편입니다</span>
              )}
            </div>
            <a class="series-navigation__index" href={`/series/${post.data.series.slug}/`}>
              전체 연재 보기
            </a>
            <div class="series-navigation__next">
              {nextSeriesPost ? (
                <a href={`/posts/${nextSeriesPost.id}/`}>
                  <span>다음 편</span>
                  {nextSeriesPost.data.title}
                </a>
              ) : (
                <span class="series-navigation__empty">현재 마지막 편입니다</span>
              )}
            </div>
          </nav>
        )
      }

      {
        relatedPosts.length > 0 && (
          <section class="related-posts" aria-labelledby="related-posts-title">
            <div class="section-heading">
              <h2 id="related-posts-title">이어서 읽기</h2>
            </div>
            <div class="related-posts__grid">
              {relatedPosts.map((relatedPost) => <RelatedPostCard post={relatedPost} />)}
            </div>
          </section>
        )
      }

      <div class="article-footer__actions">
        <a
          class="back-link"
          href={archiveHref}
          data-analytics-event="related_post_click"
          data-analytics-target="track_archive"
        >← {archiveLabel}</a>
        <a class="back-link" href="/archives/">전체 아카이브 보기 →</a>
      </div>
    </footer>
  </article>
</BaseLayout>
