---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  sortPosts,
  TECH_CATEGORIES,
  type TechCategory,
} from '../../lib/content';
import { breadcrumbSchema, collectionPageSchema } from '../../lib/schema';
import { getPublishedSeries } from '../../lib/series';

export function getStaticPaths() {
  return Object.keys(TECH_CATEGORIES).map((category) => ({ params: { category } }));
}

const categoryKey = Astro.params.category as TechCategory;
const category = TECH_CATEGORIES[categoryKey];
const posts = sortPosts(
  await getCollection(
    'posts',
    ({ data }) =>
      !data.draft && data.track === 'tech_column' && data.category === categoryKey,
  ),
);
const seriesEntries = getPublishedSeries(
  await getCollection('posts', ({ data }) => !data.draft),
).filter((series) => series.category === categoryKey);
const path = `/categories/${categoryKey}/`;
const title = `${category.label} 기술 해설 모음`;
---

<BaseLayout
  title={title}
  description={`${category.description} ${category.label} 관련 글 ${posts.length}편과 연재 ${seriesEntries.length}개를 모았습니다.`}
  noindex={posts.length === 0}
  jsonLd={[
    breadcrumbSchema(
      [{ name: '홈', path: '/' }, { name: '기술 해설', path: '/tracks/tech_column/' }, { name: category.label, path }],
      Astro.site,
    ),
    collectionPageSchema(
      { name: title, description: category.description, path, postPaths: posts.map((post) => `/posts/${post.id}/`) },
      Astro.site,
    ),
  ]}
>
  <div class="shell listing-page">
    <nav class="breadcrumb" aria-label="현재 위치">
      <a href="/">홈</a><span aria-hidden="true">/</span><a href="/tracks/tech_column/">기술 해설</a>
    </nav>
    <header class="listing-header">
      <p class="eyebrow">TOPIC CATEGORY</p>
      <h1>{category.label}</h1>
      <p>{category.description}</p>
      <p class="listing-summary">{posts.length}개의 글 · {seriesEntries.length}개의 연재</p>
    </header>

    {
      seriesEntries.length > 0 && (
        <section class="category-directory" aria-labelledby="subcategory-directory-heading">
          <div class="section-heading">
            <h2 id="subcategory-directory-heading">이 카테고리의 연재</h2>
            <a class="section-heading__link" href="/series/">전체 연재 보기 →</a>
          </div>
          <div class="category-index__grid category-index__grid--wide">
            {seriesEntries.map((series) => (
              <a
                class="category-index__item series-index__item"
                style={`--category-accent: var(--${category.tone})`}
                href={`/series/${series.slug}/`}
              >
                <span>{series.title}</span>
                <p>{series.description}</p>
                <p class="series-index__count">{series.posts.length}편 · 순서대로 읽기</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      posts.length > 0 ? (
        <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
      ) : (
        <section class="empty-state">
          <h2>연재를 준비하고 있습니다</h2>
          <p>첫 글이 발행되면 이 카테고리에서 순서대로 읽을 수 있습니다.</p>
        </section>
      )
    }
  </div>
</BaseLayout>
