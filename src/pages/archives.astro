---
import { getCollection } from 'astro:content';
import CompactPostList from '../components/CompactPostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortPosts, sortUpdatedPosts } from '../lib/content';
import { breadcrumbSchema, collectionPageSchema } from '../lib/schema';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const recentlyUpdated = sortUpdatedPosts(posts).slice(0, 5);
const postsByYear = new Map<number, typeof posts>();

for (const post of posts) {
  const year = post.data.publishedAt.getFullYear();
  const yearPosts = postsByYear.get(year) ?? [];
  yearPosts.push(post);
  postsByYear.set(year, yearPosts);
}
---

<BaseLayout
  title="아카이브 — 전체 글 목록"
  description={`3분만에 만화로 보는 IT의 발행 글 ${posts.length}편을 연도별로 정리했습니다. AI 논문, AI 뉴스, 기술 해설 만화를 날짜순으로 찾습니다.`}
  jsonLd={[
    breadcrumbSchema([{ name: '홈', path: '/' }, { name: '아카이브', path: '/archives/' }], Astro.site),
    collectionPageSchema(
      { name: '아카이브', description: '발행 글 전체 목록', path: '/archives/', postPaths: posts.map((post) => `/posts/${post.id}/`) },
      Astro.site,
    ),
  ]}
>
  <div class="shell listing-page archive-page">
    <header class="listing-header">
      <p class="eyebrow">ARCHIVES</p>
      <h1>아카이브</h1>
      <p>발행된 글을 연도별로 살펴보고, 최근에 내용이 갱신된 글을 다시 찾습니다.</p>
      <p class="listing-summary">총 {posts.length}개의 글</p>
    </header>

    {
      recentlyUpdated.length > 0 && (
        <section class="archive-section" aria-labelledby="archive-updated-heading">
          <div class="section-heading">
            <h2 id="archive-updated-heading">최근 수정한 글</h2>
          </div>
          <CompactPostList posts={recentlyUpdated} dateMode="updated" />
        </section>
      )
    }

    <section class="archive-section" aria-labelledby="archive-all-heading">
      <div class="section-heading">
        <h2 id="archive-all-heading">발행 연도별 글</h2>
      </div>
      {
        [...postsByYear.entries()].map(([year, yearPosts]) => (
          <section class="archive-year" aria-labelledby={`archive-year-${year}`}>
            <h3 id={`archive-year-${year}`}>{year}</h3>
            <CompactPostList posts={yearPosts} />
          </section>
        ))
      }
    </section>
  </div>
</BaseLayout>
