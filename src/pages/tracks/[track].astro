---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME, sortPosts, TECH_CATEGORIES, TRACKS, type Track } from '../../lib/content';
import { breadcrumbSchema, collectionPageSchema } from '../../lib/schema';

export function getStaticPaths() {
  return Object.keys(TRACKS).map((track) => ({ params: { track } }));
}

const trackKey = Astro.params.track as Track;
const track = TRACKS[trackKey];
const posts = sortPosts(
  await getCollection('posts', ({ data }) => !data.draft && data.track === trackKey),
);
const path = `/tracks/${trackKey}/`;
const title = `${track.label} 만화 모음`;
---

<BaseLayout
  title={title}
  description={`${track.description} ${SITE_NAME}의 ${track.label} 글 ${posts.length}편을 최신순으로 모았습니다.`}
  noindex={posts.length === 0}
  jsonLd={[
    breadcrumbSchema([{ name: '홈', path: '/' }, { name: track.label, path }], Astro.site),
    collectionPageSchema(
      { name: title, description: track.description, path, postPaths: posts.map((post) => `/posts/${post.id}/`) },
      Astro.site,
    ),
  ]}
>
  <div class="shell listing-page">
    <header class="listing-header">
      <p class="eyebrow">CONTENT TRACK</p>
      <h1>{track.label}</h1>
      <p>{track.description}</p>
    </header>

    {
      trackKey === 'tech_column' && (
        <section class="category-directory" aria-labelledby="category-directory-heading">
          <div class="section-heading">
            <h2 id="category-directory-heading">핵심 카테고리</h2>
          </div>
          <div class="category-index__grid">
            {Object.entries(TECH_CATEGORIES)
              .filter(([key]) => posts.some((post) => post.data.category === key))
              .map(([key, category]) => (
              <a
                class="category-index__item"
                style={`--category-accent: var(--${category.tone})`}
                href={`/categories/${key}/`}
              >
                <span>{category.label}</span>
                <p>{category.description}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      posts.length > 0 ? (
        <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
      ) : (
        <section class="empty-state">
          <h2>아직 발행된 글이 없습니다</h2>
          <p>완성된 에피소드가 발행 게이트를 통과하면 이 목록에 추가됩니다.</p>
        </section>
      )
    }
  </div>
</BaseLayout>
