---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts, TECH_CATEGORIES } from '../../lib/content';
import { getPublishedSeries } from '../../lib/series';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const series = getPublishedSeries(posts);
const episodeCount = series.reduce((total, entry) => total + entry.posts.length, 0);
---

<BaseLayout
  title="연재 모아보기"
  description="여러 편으로 이어지는 연재를 한곳에 모았습니다. 관심 있는 연재를 골라 1편부터 순서대로 읽습니다."
>
  <div class="shell listing-page">
    <header class="listing-header">
      <p class="eyebrow">LONG-FORM SERIES</p>
      <h1>연재 모아보기</h1>
      <p>여러 편으로 이어지는 글을 연재별로 모았습니다. 관심 있는 연재를 골라 1편부터 순서대로 읽습니다.</p>
      <p class="listing-summary">{series.length}개의 연재 · 총 {episodeCount}편</p>
    </header>

    {
      series.length > 0 ? (
        <div class="category-index__grid category-index__grid--wide">
          {series.map((entry) => (
            <a
              class="category-index__item series-index__item"
              style={`--category-accent: var(--${TECH_CATEGORIES[entry.category].tone})`}
              href={`/series/${entry.slug}/`}
            >
              <span>{entry.title}</span>
              <p>{entry.description}</p>
              <p class="series-index__count">
                {TECH_CATEGORIES[entry.category].label} · {entry.posts.length}편 · 순서대로 읽기
              </p>
            </a>
          ))}
        </div>
      ) : (
        <section class="empty-state">
          <h2>연재를 준비하고 있습니다</h2>
          <p>첫 편이 발행되면 이 페이지에서 연재별로 모아 볼 수 있습니다.</p>
        </section>
      )
    }
  </div>
</BaseLayout>
