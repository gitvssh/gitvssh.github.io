---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts, TECH_CATEGORIES } from '../../lib/content';
import { getPublishedSeries, type PublishedSeries } from '../../lib/series';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));

  return getPublishedSeries(posts).map((series) => ({
    params: { series: series.slug },
    props: { series },
  }));
}

interface Props {
  series: PublishedSeries;
}

const { series } = Astro.props;
const category = TECH_CATEGORIES[series.category];
const posts: CollectionEntry<'posts'>[] = series.posts;
---

<BaseLayout title={series.title} description={series.description}>
  <div class="shell listing-page">
    <nav class="breadcrumb" aria-label="현재 위치">
      <a href="/">홈</a><span aria-hidden="true">/</span><a href="/series/">연재</a>
      <span aria-hidden="true">/</span><a href={`/categories/${series.category}/`}>{category.label}</a>
    </nav>

    <header class="listing-header">
      <p class="eyebrow">LONG-FORM SERIES · {category.label}</p>
      <h1>{series.title}</h1>
      <p>{series.description}</p>
      <p class="listing-summary">총 {posts.length}편 · 1편부터 순서대로 읽기</p>
    </header>

    <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>

    <div class="listing-actions">
      <a class="back-link" href={`/categories/${series.category}/`}>← {category.label} 글 더 보기</a>
      <a class="back-link" href="/series/">다른 연재 보기 →</a>
    </div>
  </div>
</BaseLayout>
