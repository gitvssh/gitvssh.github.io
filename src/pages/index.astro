---
import { getCollection } from 'astro:content';
import CompactPostList from '../components/CompactPostList.astro';
import PostCard from '../components/PostCard.astro';
import TopicNavigation from '../components/TopicNavigation.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, sortPosts, sortUpdatedPosts, TECH_CATEGORIES, TRACKS } from '../lib/content';
import { webSiteSchema } from '../lib/schema';
import { SITE_DESCRIPTION, SITE_TAGLINE } from '../lib/site';
import { getPublishedTopics } from '../lib/topics';

// Full cards for the newest posts, a compact list for the rest: every post stays one click
// from the home page for crawlers, without 120+ image cards in the DOM.
const HOME_CARD_COUNT = 24;

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const [featured, ...rest] = posts;
const cardPosts = rest.slice(0, HOME_CARD_COUNT);
const olderPosts = rest.slice(HOME_CARD_COUNT);
const recentlyUpdated = sortUpdatedPosts(posts).slice(0, 3);
const topics = getPublishedTopics(posts);
const publishedCategories = Object.entries(TECH_CATEGORIES).filter(([key]) =>
  posts.some((post) => post.data.category === key),
);
---

<BaseLayout
  title={`${SITE_NAME} | ${SITE_TAGLINE}`}
  socialTitle={SITE_NAME}
  description={SITE_DESCRIPTION}
  completeTitle
  jsonLd={webSiteSchema(Astro.site)}
>
  <section class="masthead">
    <div class="shell masthead__inner">
      <p class="eyebrow">3 MINUTES · IT COMICS</p>
      <h1>{SITE_NAME}</h1>
      <p>AI 논문 읽기, AI 뉴스, 기술 해설과 AI 활용을 만화로 먼저 이해합니다.</p>
    </div>
  </section>

  <div class="shell discovery-layout discovery-layout--home">
    <div class="home-content discovery-layout__main">
    {
      featured ? (
        <section class="featured" aria-labelledby="featured-heading">
          <div class="section-heading">
            <h2 id="featured-heading">최근 글</h2>
            <span>{posts.length}개의 글</span>
          </div>
          <PostCard post={featured} prominent />
        </section>
      ) : (
        <section class="empty-state">
          <h2>첫 글을 준비하고 있습니다</h2>
          <p>발행 가능한 에피소드가 추가되면 이곳에 표시됩니다.</p>
        </section>
      )
    }

    {
      recentlyUpdated.length > 0 && (
        <section class="recent-updates" aria-labelledby="recent-updates-heading">
          <div class="section-heading">
            <h2 id="recent-updates-heading">최근 수정한 글</h2>
            <a class="section-heading__link" href="/archives/">아카이브 보기 →</a>
          </div>
          <CompactPostList posts={recentlyUpdated} dateMode="updated" />
        </section>
      )
    }

    <section class="category-index" aria-labelledby="categories-heading">
      <div class="section-heading">
        <h2 id="categories-heading">주제별 카테고리</h2>
        <a class="section-heading__link" href="/series/">연재 모아보기 →</a>
      </div>
      <div class="category-index__grid">
        {
          publishedCategories.map(([key, category]) => (
            <a
              class="category-index__item"
              style={`--category-accent: var(--${category.tone})`}
              href={`/categories/${key}/`}
            >
              <span>{category.label}</span>
              <p>{category.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    {
      cardPosts.length > 0 && (
        <section class="latest" aria-labelledby="latest-heading">
          <div class="section-heading">
            <h2 id="latest-heading">최신 글</h2>
            <a class="section-heading__link" href="/archives/">전체 아카이브 →</a>
          </div>
          <div class="post-list">{cardPosts.map((post) => <PostCard post={post} />)}</div>
        </section>
      )
    }

    {
      olderPosts.length > 0 && (
        <section class="older-posts" aria-labelledby="older-heading">
          <div class="section-heading">
            <h2 id="older-heading">이전 글</h2>
            <span>{olderPosts.length}개의 글</span>
          </div>
          <CompactPostList posts={olderPosts} />
        </section>
      )
    }

    <section class="track-index" aria-labelledby="tracks-heading">
      <div class="section-heading">
        <h2 id="tracks-heading">콘텐츠 유형</h2>
      </div>
      <div class="track-index__grid">
        {
          Object.entries(TRACKS).map(([key, track]) => (
            <a class={`track-index__item track-index__item--${key}`} href={`/tracks/${key}/`}>
              <span>{track.label}</span>
              <p>{track.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    </div>

    <TopicNavigation topics={topics} />
  </div>
</BaseLayout>
