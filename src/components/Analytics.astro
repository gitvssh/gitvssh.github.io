---
// Reading-behaviour events forwarded through the Zaraz transport (src/lib/analytics.ts).
// No vendor script, no measurement ID, no consent UI: Cloudflare Zaraz injects itself at the
// edge and enforces consent before any tool runs. This component only decides *when* an event
// is worth sending.
---

<script>
  import { dispatchAnalyticsEvent } from '../lib/analytics';

  window.blogAnalytics = { event: dispatchAnalyticsEvent };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest<HTMLElement>('[data-analytics-event]');
    if (trigger?.dataset.analyticsEvent) {
      dispatchAnalyticsEvent(trigger.dataset.analyticsEvent, {
        target: trigger.dataset.analyticsTarget || 'unknown',
      });
      return;
    }

    const contextualPostLink = target.closest<HTMLAnchorElement>('.prose a[href^="/posts/"]');
    if (!contextualPostLink) return;
    const segments = new URL(contextualPostLink.href).pathname.split('/').filter(Boolean);
    dispatchAnalyticsEvent('related_post_click', { target: segments.at(-1) || 'contextual_post' });
  });

  const article = document.querySelector<HTMLElement>('[data-analytics-article]');
  if (article) {
    const context = {
      content_id: article.dataset.contentId,
      content_track: article.dataset.contentTrack,
      content_category: article.dataset.contentCategory,
    };
    let timeReached = false;
    let depthReached = false;
    let engagedSent = false;
    let completeSent = false;

    const tryEngagedRead = () => {
      if (!timeReached || !depthReached || engagedSent) return;
      engagedSent = true;
      dispatchAnalyticsEvent('engaged_read', context);
    };

    const measureDepth = () => {
      const articleTop = article.getBoundingClientRect().top + window.scrollY;
      const viewed = window.scrollY + window.innerHeight - articleTop;
      depthReached = viewed / article.offsetHeight >= 0.5;
      tryEngagedRead();
    };

    window.setTimeout(() => {
      timeReached = true;
      tryEngagedRead();
    }, 30000);
    window.addEventListener('scroll', measureDepth, { passive: true });
    window.addEventListener('resize', measureDepth);
    measureDepth();

    const completionTarget = article.querySelector('[data-analytics-complete]');
    if (completionTarget && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (completeSent || !entries.some((entry) => entry.isIntersecting)) return;
          completeSent = true;
          dispatchAnalyticsEvent('article_complete', context);
          observer.disconnect();
        },
        { threshold: 0.35 },
      );
      observer.observe(completionTarget);
    }
  }
</script>
