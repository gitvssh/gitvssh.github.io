---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, getPostDisplayTitle, TECH_CATEGORIES, TRACKS } from '../lib/content';

interface Props {
  post: CollectionEntry<'posts'>;
  prominent?: boolean;
}

const { post, prominent = false } = Astro.props;
const track = TRACKS[post.data.track];
const category = post.data.category ? TECH_CATEGORIES[post.data.category] : undefined;
const displayTitle = getPostDisplayTitle(post.data);
---

<article class:list={['post-card', { 'post-card--prominent': prominent }]}>
  <a class="post-card__image" href={`/posts/${post.id}/`} tabindex="-1" aria-hidden="true">
    <Image
      src={post.data.cover}
      alt=""
      widths={prominent ? [420, 640, 860] : [240, 400, 560]}
      sizes={prominent ? '(min-width: 800px) 44vw, 100vw' : '(min-width: 800px) 280px, 100vw'}
      format="webp"
      loading={prominent ? 'eager' : 'lazy'}
    />
  </a>
  <div class="post-card__body">
    <div class="post-meta">
      <a class={`track-label track-label--${post.data.track}`} href={`/tracks/${post.data.track}/`}>
        {track.label}
      </a>
      {category && (
        <a class="category-label" href={`/categories/${post.data.category}/`}>{category.label}</a>
      )}
      {post.data.series && (
        <a class="series-label" href={`/series/${post.data.series.slug}/`}>
          {post.data.series.title} {post.data.series.order}편
        </a>
      )}
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
    </div>
    <h2><a href={`/posts/${post.id}/`}>{displayTitle}</a></h2>
    <p>{post.data.description}</p>
    <a class="text-link" href={`/posts/${post.id}/`}>글 읽기 <span aria-hidden="true">→</span></a>
  </div>
</article>
