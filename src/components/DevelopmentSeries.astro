---
import type { CollectionEntry } from 'astro:content';
import { getPublishedSeries } from '../lib/series';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const series = getPublishedSeries(posts).filter(
  (entry) => entry.category === 'development_episode',
);
---

{
  series.length > 0 && (
    <section class="development-series" aria-labelledby="development-series-heading">
      <div class="section-heading development-series__heading">
        <h2 id="development-series-heading">직접 만들고 운영한 기록</h2>
        <a class="section-heading__link" href="/categories/development_episode/">
          개발 에피소드 모두 보기 →
        </a>
      </div>
      <div class="development-series__grid">
        {series.map((entry) => (
          <article class="development-series__card">
            <h3><a href={`/series/${entry.slug}/`}>{entry.title}</a></h3>
            <p class="development-series__description">{entry.description}</p>
            <p class="development-series__count">총 {entry.posts.length}편</p>
            {entry.posts[0] && (
              <a class="development-series__start" href={`/posts/${entry.posts[0].id}/`}>
                <span>1편부터 읽기 →</span>
                {entry.posts[0].data.title}
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .development-series {
    margin-bottom: 66px;
  }

  .development-series__heading {
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .development-series__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 14px;
  }

  .development-series__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 22px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--green);
    border-radius: 6px;
    background: var(--surface);
  }

  .development-series__card h3 {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
  }

  .development-series__card h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .development-series__card h3 a:hover {
    text-decoration: underline;
  }

  .development-series__description {
    margin: 12px 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .development-series__count {
    margin: auto 0 14px;
    color: var(--muted);
    font-size: 12px;
  }

  .development-series__start {
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.6;
    text-decoration: none;
  }

  .development-series__start span {
    display: block;
    margin-bottom: 4px;
    color: var(--green);
    font-weight: 800;
  }

  .development-series__start:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .development-series {
      margin-bottom: 48px;
    }
  }
</style>
