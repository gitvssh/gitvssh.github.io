---
import { SITE_NAME, TECH_CATEGORIES, TRACKS } from '../lib/content';

const currentPath = Astro.url.pathname;
const isCurrent = (path: string) =>
  path === '/' ? currentPath === path : currentPath.startsWith(path);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label={`${SITE_NAME} 홈`}>
      <span class="wordmark__mark" aria-hidden="true">3</span>
      <span>{SITE_NAME}</span>
    </a>

    <nav aria-label="주요 메뉴">
      <ul class="site-nav">
        {
          Object.entries(TRACKS).map(([key, track]) => {
            const href = key === 'practice' ? '/topics/ai-use/' : `/tracks/${key}/`;

            return (
              <li>
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {track.label}
                </a>
              </li>
            );
          })
        }
        <li>
          <a
            href="/categories/development_episode/"
            aria-current={isCurrent('/categories/development_episode/') ? 'page' : undefined}
          >
            {TECH_CATEGORIES.development_episode.label}
          </a>
        </li>
        <li>
          <a
            href="/categories/ai_philosophy/"
            aria-current={isCurrent('/categories/ai_philosophy/') ? 'page' : undefined}
          >
            {TECH_CATEGORIES.ai_philosophy.label}
          </a>
        </li>
        <li>
          <a href="/archives/" aria-current={isCurrent('/archives/') ? 'page' : undefined}>
            아카이브
          </a>
        </li>
        <li>
          <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>
            소개
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
