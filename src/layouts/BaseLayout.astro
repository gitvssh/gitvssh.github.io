---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Analytics from '../components/Analytics.astro';
import MermaidDiagrams from '../components/MermaidDiagrams.astro';
import { SITE_NAME } from '../lib/content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  socialTitle?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  completeTitle?: boolean;
}

const {
  title,
  description = '논문 읽기, 기술 해설, 개발 뉴스와 AI 활용·실습을 만화와 정확한 한국어 글로 설명합니다.',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  socialTitle,
  type = 'website',
  noindex = false,
  completeTitle = false,
} = Astro.props;

const pageTitle = title ? (completeTitle ? title : `${title} | ${SITE_NAME}`) : SITE_NAME;
const openGraphTitle = socialTitle ?? pageTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="UkOytDtaiEDqpk_9kZIlE_dKnhLe0Ohbf4MBE2eYyjk" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={new URL('rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={openGraphTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {socialImage && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {socialImage && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {socialImage && <meta property="og:image:type" content="image/webp" />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 이동</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
    <MermaidDiagrams />
  </body>
</html>
